# Optional HTTPS RPC override; CLI reads the process environment, not this file.
MONAD_IDENTITY_RPC_URL=
# Local evidence generation only; never configure on the public Vercel project.
ENVIO_API_TOKEN=

ALCHEMY_MONAD_TESTNET_RPC_URL=

# Local CLI deployment only; never configure on the public Vercel project.
DEPLOYER_PRIVATE_KEY=

# Explicitly locks public publication controls; Vercel also locks them via VERCEL=1.
SIGNAL_PASSPORT_PUBLIC_READ_ONLY=

# Public Dynamic project identifier (not a secret)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
